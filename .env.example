# ─── Frontend (Firebase web config — publiek, beveiliging zit in de rules) ────
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=je-planning.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=je-planning
VITE_FIREBASE_STORAGE_BUCKET=je-planning.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:aaaaaaaaaaaa
VITE_APP_URL=https://planning.jeconcept.be

# Webpush-certificaat voor meldingen op de telefoon. Firebase Console →
# Project settings → Cloud Messaging → Web configuration → Generate key pair.
# Leeg laten kan: de app werkt dan gewoon, alleen blijft "Meldingen aanzetten"
# uitgeschakeld.
VITE_FIREBASE_VAPID_KEY=

# Google Maps — voor het kiezen van de locatie op een event. Google Cloud
# Console → APIs & Services → Credentials → Create API key, daarna "Places API
# (New)" aanzetten en de sleutel beperken tot HTTP-verwijzers
# (https://planning.jeconcept.be/*). Zonder deze sleutel blijft het
# locatieveld een gewoon tekstveld — alles werkt, er is alleen geen lijst met
# adressen en geen precieze kaartlink.
VITE_GOOGLE_MAPS_API_KEY=

# Het enige adres waarop de tool hoort te draaien. Zodra planning.jeconcept.be
# in Firebase Hosting op "Connected" staat, stuurt <project>.web.app hierheen
# door. Leeg laten zolang het domein nog niet gekoppeld is.
VITE_CANONICAL_HOST=planning.jeconcept.be

# Zet op 1 om tegen de lokale emulators te werken (npm run emulators)
VITE_USE_EMULATORS=

# ─── ClickUp-migratie (scripts/migrate-clickup.mjs, enkel lokaal) ────────────
CLICKUP_TOKEN=pk_...
CLICKUP_TEAM_ID=24317841
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
