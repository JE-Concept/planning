# ─── Frontend (Firebase web config — publiek, beveiliging zit in de rules) ────
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=je-planning.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=je-planning
VITE_FIREBASE_STORAGE_BUCKET=je-planning.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:aaaaaaaaaaaa
VITE_APP_URL=https://planning.jeconcept.be

# Zet op 1 om tegen de lokale emulators te werken (npm run emulators)
VITE_USE_EMULATORS=

# ─── Cloud Functions secrets (firebase functions:secrets:set NAAM) ────────────
# CANVA_CLIENT_ID       Canva Connect app id      — https://www.canva.com/developers
# CANVA_CLIENT_SECRET   Canva Connect app secret
# CANVA_REDIRECT_URI    https://planning.jeconcept.be/api/canva/callback

# ─── ClickUp-migratie (scripts/migrate-clickup.mjs, enkel lokaal) ────────────
CLICKUP_TOKEN=pk_...
CLICKUP_TEAM_ID=24317841
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
