rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid));
    }

    // Task attachments and social media assets.
    match /attachments/{allPaths=**} {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.size < 25 * 1024 * 1024;
    }

    /*
      Productfoto's van het verhuurmateriaal (vraag 9 in docs/vragen-productie.md).

      Schrijven mag een beheerder: wat hier staat, komt op een openbare pagina.
      Lezen mag het team; de verhuursite zelf leest via de download-URL met
      token die bij het uploaden gemaakt wordt — die werkt los van deze
      regels, en de site heeft geen Storage-SDK om hier langs te komen.
      Alleen afbeeldingen, en niet groter dan 5 MB: een foto van 12 MB van
      een telefoon maakt de catalogus traag voor iedereen die hem opent.
    */
    match /materiaal/{id}/{bestand} {
      allow read: if isMember();
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role in ['owner', 'admin']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid} {
      allow read: if isMember();
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
