# Plaatsvervangers voor de demobuild. Er wordt geen enkele Firebase-dienst
# aangesproken: in deze modus wijzen de firebase/*-imports naar demo/.
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=je-planning-demo
VITE_FIREBASE_STORAGE_BUCKET=demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_APP_URL=https://planning.jeconcept.be
