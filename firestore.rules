rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ JE Planning — Firestore security rules                                   ║
// ║                                                                          ║
// ║ One shared workspace: every active profile reads and writes the planning.║
// ║ Not shared: member administration (admins only), your own time entries   ║
// ║ (you edit yours, admins edit all).                                       ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    // A profile only exists once `ensureProfile` accepted the e-mail address,
    // so "has a profile" is the membership check.
    function isMember() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true;
    }

    function role() {
      return get(profilePath()).data.role;
    }

    // De planningsgebruikers: iedereen met een profiel behalve personeel en de
    // socialrol.
    //
    // Personeel heeft een beperkte login — de openings- en sluitingslijst, en
    // verder niets. De socialrol werkt alleen in de socials. Dat onderscheid
    // staat hier en niet alleen in de interface, want een verborgen knop is
    // geen beveiliging.
    function isTeam() {
      return isMember() && role() != 'staff' && role() != 'social';
    }

    /*
      De socialrol: een medewerker die de content doet en verder niets.

      Wat ze niet mag lezen, is even belangrijk als wat ze wel mag: `tasks`
      staat niet in haar lijst, en daar staan de offertebedragen, budgetten en
      kostprijzen van elk event op. Firestore kan geen velden verbergen — wie
      een document mag lezen, leest het hele document, ook wat het scherm niet
      toont. Daarom leest ze de events uit `socialEvents`, een kale kopie
      zonder één bedrag erin, die een trigger bijhoudt.

      Datzelfde geldt voor `formules` (prijzen per persoon), `customers`
      (facturatiegegevens) en `offertes`. Die staan hier niet, en dat is het
      antwoord op "ze ziet geen prijzen".
    */
    function isSocial() {
      return isMember() && role() == 'social';
    }

    /*
      Wie in de bistro werkt: het team en het zaalpersoneel, en dus niet de
      socialrol.

      `isMember()` is iedereen met een profiel, en dat was voor de dagelijkse
      lijsten en het rooster precies goed zolang de rollen team en personeel
      waren: die twee werken allebei in de zaak. Met de socialrol erbij klopt
      het niet meer — zij kon de afvinklijsten lezen en zelfs afvinken, terwijl
      ze daar niets te zoeken heeft. Geen bedragen, dus geen lek, maar wel een
      deur die openstond zonder reden.
    */
    function isBistro() {
      return isMember() && role() != 'social';
    }

    /*
      Een medewerker: student of flexi. Beperkte login — de openings- en
      sluitingslijst, en de events waarop hij zelf staat. Geen bedragen, en dus
      geen `tasks`: die leest hij uit de kale kopie in `socialEvents`.
    */
    function isStaff() {
      return isMember() && role() == 'staff';
    }

    function isAdmin() {
      return isMember() && role() in ['owner', 'admin'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /*
      ── Waarom hier vormcontroles staan ──────────────────────────────────

      Tot nu keken de regels alleen naar wie er schreef, niet naar wát er
      geschreven werd. Wie mocht schrijven, mocht álles schrijven: een
      offertebedrag als tekst, een titel die leeg is, een aantal gasten van
      min tien. Dat is geen wantrouwen tegenover het team — het is een
      openstaand tabblad met oude code, een script dat ernaast zit, of een
      veld dat ooit een keuzelijst was en nu vrije tekst. De rapportage klopt
      dan niet meer en niemand weet waarom.

      Alleen de velden waar geld, tijd en rapportage aan hangen worden
      gecontroleerd. De rest blijft vrij: een regel die elk nieuw veld
      vooraf moet kennen, is een regel die bij elke wijziging in de weg
      staat en dan uitgezet wordt.
    */

    /** Een veld dat er mag zijn of niet, maar als het er is, het juiste type. */
    function tekstOfNiets(veld) {
      return !(veld in request.resource.data)
        || request.resource.data[veld] == null
        || request.resource.data[veld] is string;
    }

    function getalOfNiets(veld) {
      return !(veld in request.resource.data)
        || request.resource.data[veld] == null
        || request.resource.data[veld] is number;
    }

    /** Een bedrag: een getal, niet negatief, en binnen wat een event kan kosten. */
    function bedragOfNiets(veld) {
      return getalOfNiets(veld)
        && (!(veld in request.resource.data) || request.resource.data[veld] == null
            || (request.resource.data[veld] >= 0 && request.resource.data[veld] <= 10000000));
    }

    /** Een aantal personen, dagen of uren: een heel getal dat niet negatief is. */
    function aantalOfNiets(veld) {
      return getalOfNiets(veld)
        && (!(veld in request.resource.data) || request.resource.data[veld] == null
            || (request.resource.data[veld] >= 0 && request.resource.data[veld] <= 100000));
    }

    function lijstOfNiets(veld) {
      return !(veld in request.resource.data)
        || request.resource.data[veld] == null
        || request.resource.data[veld] is list;
    }

    /*
      Wie iets aanmaakte en wanneer, verandert nooit meer.

      Een aanmaakdatum die opschuift maakt elk rapport over doorlooptijd
      waardeloos, en een `createdBy` die van naam wisselt maakt het logboek
      een verhaal in plaats van een geheugen. Bijwerken mag alles behalve dit.
    */
    function herkomstBlijft() {
      return !changedKeys().hasAny(['createdAt', 'createdBy']);
    }

    // ── People ────────────────────────────────────────────────────────────

    match /profiles/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);

      // Je mag je eigen kaartje bijwerken, maar nooit je eigen rol of toegang —
      // en dat geldt ook voor een beheerder. Wie zichzelf op "personeel" zet of
      // zichzelf archiveert, sluit zichzelf buiten en heeft dan niemand meer om
      // het terug te draaien. Dit hoort in de regels en niet alleen in een
      // uitgeschakeld keuzelijstje: een verborgen knop is geen beveiliging.
      allow update: if (isAdmin()
            && (request.auth.uid != uid || !changedKeys().hasAny(['role', 'active'])))
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['fullName', 'avatarUrl', 'prefs', 'updatedAt']));

      allow create, delete: if isAdmin();
    }

    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // Meldingen: één rij per toestel, gesleuteld op het token zelf.
    //
    // Je beheert alleen je eigen toestellen. Lezen mag ook alleen je eigen rij:
    // de lijst met tokens van de ploeg is niets voor in de browser — versturen
    // doet een Cloud Function, die er met beheerdersrechten bij kan.
    match /pushTokens/{token} {
      allow read, delete: if isMember() && resource.data.profileId == request.auth.uid;
      // Bij het schrijven telt de nieuwe eigenaar, niet de oude: meldt een
      // collega zich aan op een toestel waar jij aan stond, dan neemt zij die
      // rij over. Het token is het geheim van dat toestel — wie het heeft, ís
      // dat toestel.
      allow create, update: if isMember() && request.resource.data.profileId == request.auth.uid;
    }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // De postbak van de meldingen: één rij per e-mail die nog moet vertrekken.
    //
    // Dicht voor iedereen, ook voor beheerders. Er staan adressen en volledige
    // berichtteksten in van het hele team, en geen enkel scherm heeft ze nodig:
    // de triggers schrijven erin en de verzender leest eruit, allebei met
    // beheerdersrechten, die deze regels sowieso overslaan. Wat hier staat is
    // dus geen slot maar een bordje: dit is niets voor in een browser.
    match /mailQueue/{id} {
      allow read, write: if false;
    }

    // ── The workspace itself ──────────────────────────────────────────────

    // De merken en de lijsten leest de socialrol mee: zonder merk is een post
    // van niemand, en zonder lijst weet het bord niet welke kolommen het heeft.
    // Er staat geen bedrag in.
    match /brands/{id}      { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    match /spaces/{id}      { allow read: if isTeam(); allow write: if isTeam(); }
    match /folders/{id}     { allow read: if isTeam(); allow write: if isTeam(); }
    match /lists/{id}       { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    match /tags/{id}        { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    /*
      De events en de taken. `tasks` draagt de bedragen, dus de socialrol leest
      er niets uit — ze werkt met de kale kopie in `socialEvents`.

      Schrijven mag ze wel, maar alleen wat over content gaat: de stand op het
      socialbord verzetten. Welke velden dat zijn staat hieronder als lijst, en
      niet als "alles behalve": vergeet je bij een verbodslijst één veld, dan
      kan ze het offertebedrag aanpassen zonder het ooit gezien te hebben.

      Een eigen socialtaak aanmaken en bijwerken mag volledig — die hangt aan
      een sociallijst en heeft met geld niets te maken.
    */
    function socialVelden() {
      return changedKeys().hasOnly(['socialStage', 'socialWanted', 'updatedAt', 'updatedBy', 'position']);
    }

    // Een sociallijst herken je aan de lijst zelf (`kind: 'social'`), niet aan
    // een veld op de taak: dat veld zou de schrijver zelf kunnen invullen.
    function lijstIsSocial(listId) {
      return exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.kind == 'social';
    }

    /*
      De vorm van een taak of event.

      `title` is het enige dat er moet zijn: een taak zonder titel is een lege
      rij die niemand kan thuisbrengen. De rest mag ontbreken — een aanvraag
      begint nu eenmaal met een naam en verder niets — maar als ze er staat,
      staat ze in het juiste type.
    */
    function taakVorm() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && bedragOfNiets('quoteAmount')
        && bedragOfNiets('budget')
        && aantalOfNiets('pax')
        && aantalOfNiets('kids')
        && aantalOfNiets('trackedSeconds')
        && tekstOfNiets('location')
        && tekstOfNiets('statusName')
        && tekstOfNiets('planning')
        && tekstOfNiets('customerId')
        && lijstOfNiets('assignees')
        // De ploeg die komt werken. Een eigen lijst naast `assignees`, want
        // dat veld draagt wie verantwoordelijk is — zie `@lib/eventteam`.
        && lijstOfNiets('medewerkers')
        && lijstOfNiets('tags');
    }

    match /tasks/{id} {
      allow read:   if isTeam();
      allow create: if isTeam() && taakVorm();
      allow update: if isTeam() && taakVorm() && herkomstBlijft();
      allow delete: if isTeam();
      allow create: if isSocial() && lijstIsSocial(request.resource.data.listId);
      allow update: if isSocial()
        && (socialVelden() || (lijstIsSocial(resource.data.listId) && lijstIsSocial(request.resource.data.listId)));
      allow delete: if isSocial() && lijstIsSocial(resource.data.listId);
    }

    /*
      De kale kopie van de events, voor de socialrol.

      Alleen de trigger schrijft erin, met beheerdersrechten — die gaan hier
      sowieso niet langs. Dat niemand anders mag schrijven staat er toch, want
      een kopie die een browser kan bewerken is geen kopie meer.
    */
    /*
      De planning uit AAPI.

      Lezen doet het team; personeel en de socialrol niet — in `aapiEmployees`
      staan de statuten van de hele ploeg, en dat is personeelsinformatie.

      Schrijven doet niemand vanuit een browser. Wat uit AAPI komt, komt uit
      AAPI: een tabblad dat een starttijd kan veranderen maakt van de import een
      bron die met zichzelf in de knoop ligt, en bij de volgende import is niet
      meer te zeggen wie gelijk had. De import loopt dus server-side (zie
      `functions/aapi-import.js`).

      De koppeling naar een event is wél een menselijke beslissing — maar ook
      die gaat via een functie en niet via deze regels. Zo staat op één plek
      wat een geldige koppeling is, en kan `linkedBy` niet gelogen worden.
    */
    /*
      De voorbeeldkaartjes bij links in notities.

      Lezen mag het team — het is een titel en een plaatje van een openbare
      pagina. Schrijven doet alleen de functie: een kaartje dat een browser kan
      bewerken, is een kaartje waarin iemand een andere titel en een ander
      adres kan zetten, en dan is het een val in plaats van een hulp.
    */
    /*
      De cijfercodes van de ploeg.

      Geen enkel tabblad komt hierbij, ook een beheerder niet. Zou het team
      mogen lezen, dan leest iedereen iedereens code — en wie hem wil inkijken,
      doet dat via `ploegCodeLezen`, die het in een logboek zet. Dat is wat
      "zichtbaar in de backoffice" draaglijk maakt: niet dat niemand kan
      kijken, maar dat kijken een spoor nalaat.

      Schrijven doet alleen de functie die de code ook controleert. Kon een
      browser hier schrijven, dan zette iemand de code van een ander op vier
      cijfers naar keuze en meldde zich als hem aan.
    */
    match /personeelCodes/{id} {
      allow read, write: if false;
    }

    /* Wie welke code inkeek. Alleen de functie schrijft; beheerders lezen. */
    match /personeelCodeGelezen/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /linkVoorbeelden/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    match /aapiShifts/{id} {
      /*
        Het team leest alles; een medewerker alleen zijn eigen diensten.

        `request.auth.token.aapiEmployeeId` is een claim die bij het aanmelden
        met een code meegegeven wordt — zie `functions/ploeg.js`. Een claim en
        geen veld in zijn profiel: een claim zet hij niet zelf.

        De vraag moet zelf ook zo beperkt zijn, want Firestore weigert een
        `list` die méér zou kunnen opleveren. Dat is de bedoeling: er bestaat
        geen vraag waarmee hij de uren van een collega te zien krijgt.
      */
      allow read:  if isTeam()
        || (isMember() && resource.data.aapiEmployeeId == request.auth.token.aapiEmployeeId);
      allow write: if false;
    }

    match /aapiEmployees/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    match /aapiImportRuns/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    /*
      De wachtrij van bijlagen die per mail binnenkwamen.

      Lezen mag het team, zodat op het importscherm te zien is wat er is
      binnengekomen en wat ermee gebeurd is — ook wanneer het niets werd.
      Schrijven doet alleen de mailophaler, met beheerdersrechten.
    */
    match /aapiImportQueue/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    match /socialEvents/{id} {
      /*
        Een medewerker leest alleen de events waarop hij zelf staat.

        Dat staat hier en niet in een filter op het scherm: een filter in de
        browser bepaalt wat je ziet, een regel bepaalt wat je krijgt. Dit werkt
        alleen als de vraag zelf ook zo beperkt is — Firestore weigert een
        `list` die méér zou kunnen opleveren dan wat hier toegestaan is — en
        dat is precies de bedoeling: er bestaat geen vraag die er meer uithaalt.
      */
      allow read:  if isTeam() || isSocial()
        || (isStaff() && request.auth.uid in resource.data.medewerkers);
      allow write: if false;
    }

    // Klanten: bedrijfsgegevens, contactpersonen en wat er aan documenten bij
    // hoort. Hetzelfde recht als de events die eraan hangen — wie de planning
    // doet, doet de klant.
    /*
      Klanten. `portalToken` is de sleutel van hun eigen pagina; die wordt
      vanuit de tool gezet en verder alleen door de functie gelezen — die gaat
      hier met beheerdersrechten langs en niet door deze regels.
    */
    /*
      Een klant heeft een naam nodig en verder niets. Het btw-nummer wordt
      netjes gezet en niet geweigerd (zie `@lib/klanten`): een half nummer is
      beter dan een leeg veld, en op het scherm staat waarom het nagekeken
      moet worden.
    */
    function klantVorm() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && tekstOfNiets('vatNumber')
        && tekstOfNiets('email')
        && tekstOfNiets('phone')
        && tekstOfNiets('portalToken')
        && lijstOfNiets('contacts');
    }

    match /customers/{id} {
      allow read:   if isTeam();
      allow create: if isTeam() && klantVorm();
      allow update: if isTeam() && klantVorm() && herkomstBlijft();
      allow delete: if isTeam();
    }
    /*
      Notities: het gesprek tussen medewerkers.

      Aanmaken mag iedereen van het team, maar wissen alleen wat je zelf
      geschreven hebt. Het scherm toonde de prullenbak al enkel bij je eigen
      notitie; de regels lieten intussen iedereen alles wissen, en dat verschil
      is precies waar zoiets misgaat. Sinds notities het hoofdkanaal zijn
      waarlangs het team met elkaar praat, is een bericht dat spoorloos kan
      verdwijnen geen kleinigheid meer.

      Wijzigen kan niemand — ook de schrijver niet. Wie zich bedenkt, wist en
      schrijft opnieuw; dan staat er in de draad wat er gebeurd is. Een notitie
      die achteraf anders kan gaan luiden, is geen gesprek maar een gok.

      Beheerders mogen wél wissen: iemand vertrekt, of er staat iets dat er
      niet hoort te staan, en dan moet er een weg zijn.
    */
    /*
      Notities. Het team leest ze allemaal; wie alleen komt werken, leest de
      notitie waarin hij zelf aangesproken is.

      Dat laatste is wat taggen betekent. Iemand vermelden en hem de zin niet
      laten lezen, is een melding sturen die naar een gesloten deur wijst —
      dan is de vermelding geen vermelding maar een kennisgeving.

      Alleen díé notitie, en niet de hele draad: `mentions` is een lijst met
      accounts en de regel toetst of hij erin staat. De vraag van het scherm
      is zelf ook zo beperkt, want Firestore weigert een `list` die méér zou
      kunnen opleveren.
    */
    match /comments/{id} {
      allow read:   if isTeam() || (isMember() && request.auth.uid in resource.data.mentions);
      allow create: if isTeam() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isTeam() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    match /attachments/{id} { allow read: if isTeam(); allow write: if isTeam(); }
    match /goals/{id}       { allow read: if isTeam(); allow write: if isTeam(); }
    match /goalUpdates/{id} { allow read: if isTeam(); allow write: if isTeam(); }
    // De posts zelf: het werk van de socialrol.
    match /socialPosts/{id} { allow read: if isTeam() || isSocial(); allow write: if isTeam() || isSocial(); }

    // De lijsten zelf zijn beleid — die maakt een beheerder. De dagelijkse
    // runs zijn werk, en dat doet iedereen; niemand wist er een.
    // Een overleg staat als taak op het bord — die titel ziet het team. De
    // samenvatting zelf staat hier, en alleen wie erin genoemd is leest ze. De
    // query in de app filtert op datzelfde veld, zodat ze ook echt slaagt.
    // De agenda is van het hele team: iedereen zet er punten op. Dat is het
    // punt ervan — anders staat er alleen op wat de voorzitter onthield.
    match /agendaItems/{id} {
      allow read:          if isTeam();
      allow create, update: if isTeam();
      allow delete:        if isTeam()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /meetings/{id} {
      allow read:   if isMember() && request.auth.uid in resource.data.viewerIds;
      allow write:  if isAdmin();
    }

    // Business rules: het team ziet waarom een taak ineens van eigenaar wisselt,
    // beheerders bepalen de regels. Uitvoeren doet een Cloud Function met
    // beheerdersrechten, dus wat hier staat gaat alleen over het beheer.
    //
    // De entiteit wordt hier afgegrensd en niet alleen in het scherm. Een regel
    // draait met meer rechten dan wie hem schreef, dus "op welke collectie mag
    // een regel staan" is een beveiligingsvraag, geen keuzelijstje. Wat een
    // regel binnen die collectie mag aanraken, staat in `functions/rule-schema.js`:
    // de motor voert alleen uit wat daar als actie beschreven is, en een rol of
    // een toegang van een profiel staat daar bewust niet bij.
    function bekendeEntiteit() {
      return !('entity' in request.resource.data)
        || request.resource.data.entity in
             ['task', 'customer', 'socialPost', 'checklistRun', 'timeEntry', 'profile'];
    }

    match /automations/{id} {
      allow read:   if isTeam();
      allow create, update: if isAdmin() && bekendeEntiteit();
      allow delete: if isAdmin();
    }

    /*
      Werk dat vanzelf terugkomt.

      Lezen doet het team — iedereen hoort te kunnen zien waarom er elke
      maandag dezelfde taak staat. Beheren doet een beheerder: een herhaling
      die aan een persoon hangt, deelt werk uit, en dat is een afspraak en geen
      voorkeursinstelling.

      Schrijven van de taken zélf doet een geplande functie met
      beheerdersrechten; die gaat hier niet langs. Wat hier staat, gaat alleen
      over het recept.

      De soort wordt afgegrensd zoals bij de business rules: een herhaling met
      een onbekende soort zou elke nacht door de planner gelezen worden en
      nooit iets doen, en dat is een stille storing.
    */
    function herhalingVorm() {
      return tekstOfNiets('titel')
        && tekstOfNiets('omschrijving')
        && tekstOfNiets('prioriteit')
        && lijstOfNiets('dagen')
        && aantalOfNiets('dagVanMaand')
        && (!('soort' in request.resource.data)
            || request.resource.data.soort in ['dagelijks', 'wekelijks', 'maandelijks'])
        && (!('doel' in request.resource.data)
            || request.resource.data.doel in ['taak', 'social']);
    }

    match /herhalingen/{id} {
      allow read:   if isTeam();
      allow create, update: if isAdmin() && herhalingVorm();
      allow delete: if isAdmin();
    }

    // Het logboek van de regels: welke regel vuurde, op welk document, en bij
    // een beslissingstabel op welke rij. Alleen de server schrijft erin — zij is
    // de enige die het weet — en niemand bewerkt achteraf wat er staat. Zelfde
    // afspraak als bij het activiteitenlog: rechtzetten doe je door een regel
    // bij te schrijven, niet door er een te herschrijven.
    match /automationRuns/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    // Eventtemplates: het team leest ze bij een nieuw event, een beheerder
    // bepaalt wat erin staat.
    match /templates/{id} {
      allow read:  if isTeam();
      allow write: if isAdmin();
    }

    /*
      Verhuurmateriaal.

      Lezen doet het team: wie een event plant moet kunnen zien wat er is.
      Schrijven doet een beheerder — wat er in het magazijn staat en wat het
      kost is geen kladblok.

      Let op wat hier in staat en dus níét naar de verhuursite mag: de
      inkoopwaarde en de leverancier. Die horen bij de inkoop en niet bij de
      klant. De publieke feed is daarom een selectie die een functie maakt,
      geen doorgeefluik van dit document.
    */
    match /materiaal/{id} {
      allow read:  if isTeam();
      allow write: if isAdmin();
    }

    /*
      Wat er op dat materiaal gereserveerd staat.

      Het hele team mag reserveren: wie een event plant, legt materiaal vast,
      en daar hoeft geen beheerder aan te pas te komen. Verwijderen ook, want
      een reservatie die niet doorgaat moet weg kunnen — ze blokkeert anders
      iets voor een collega.

      Wat een browser níét mag: `materiaalDag` schrijven. Dat zijn de
      dagtellers, en die worden afgeleid uit deze collectie door
      `functions/voorraad.js`. Kon een tabblad ze zetten, dan kon het ook
      zeggen dat er nog tien tenten vrij zijn.
    */
    match /reservaties/{id} {
      allow read:   if isTeam();
      allow create: if isMember();
      allow update: if isMember();
      allow delete: if isMember();
    }

    match /materiaalDag/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }
    /*
      Online afgerekende verhuur.

      Lezen mag het team — het magazijn moet zien wat er verkocht is. Schrijven
      kan niemand: deze rijen komen uit `functions-betaling/`, dat met de
      beheerdersrechten werkt en dus langs deze regels heen gaat. Zou de
      browser hier mogen schrijven, dan kon iemand met de ontwikkelaarsconsole
      zijn eigen order op "betaald" zetten.
    */
    match /huurorders/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }
    /*
      Offerteaanvragen van de verhuursite.

      Aanmaken doet de functie, met beheerdersrechten en dus langs deze regels
      heen — de bezoeker heeft geen account. Het team leest ze en mag de stand
      bijwerken ("gebeld", "offerte verstuurd"); dat is backofficewerk.
    */
    match /verhuuraanvragen/{id} {
      allow read:   if isTeam();
      allow create: if false;
      allow update: if isMember();
      allow delete: if isAdmin();
    }
    /*
      Inlogsessies van klanten op de verhuursite. Niemand in de browser:
      niet de klant (die praat via HTTP met de functie) en niet het team
      (er staat niets in wat een mens moet lezen — hashes en vervaldagen).
    */
    match /verhuurSessies/{id} {
      allow read, write: if false;
    }

    // Vaste formules (winter bbq aan 29,90 met hapjes, drank en dessert): het
    // team kiest er een bij een nieuw event, een beheerder bepaalt de prijs en
    // de bestelregels. Een prijslijst is geen veld dat je onderweg bijstelt.
    match /formules/{id} {
      allow read:  if isTeam();
      allow write: if isAdmin();
    }

    match /checklists/{id} {
      allow read:  if isBistro();
      allow write: if isAdmin();
    }

    match /checklistRuns/{id} {
      allow read:   if isBistro();
      allow create, update: if isBistro();
      allow delete: if isAdmin();
    }

    // The review log is written by the reviewer and read by
    // everyone; nobody edits a decision after the fact, they add the next one.
    match /postReviews/{id} {
      allow read:   if isTeam() || isSocial();
      allow create: if isTeam() || isSocial();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Het activiteitslog: wie wijzigde de status, de deadline, de uitvoerders.
    //
    // Iedereen schrijft erin — de app doet dat zelf bij elke wijziging — en
    // niemand bewerkt achteraf wat er staat. Dat is het hele nut ervan: een log
    // dat je kunt bijstellen beantwoordt de vraag "wie heeft dit verzet?" niet
    // meer. Rechtzetten gebeurt door een regel bij te schrijven, niet door er
    // een te herschrijven. De query in het takenpaneel vraagt op `taskId`, wat
    // deze regel toelaat en waar `firestore.indexes.json` een index voor heeft.
    match /activity/{id} {
      allow read:   if isTeam();
      allow create: if isTeam();
      allow update, delete: if isAdmin();
    }

    // ── Time tracking: everyone sees the numbers, you own your own rows ────

    // Het weekrooster.
    //
    // Iedereen met een profiel leest het, personeel inbegrepen: wie moet weten
    // wanneer hij werkt, moet het kunnen openen. Schrijven doet een beheerder —
    // een rooster waar ieder zijn eigen diensten in verzet, is geen rooster meer.
    match /shifts/{id} {
      allow read: if isBistro();
      allow write: if isAdmin();
    }

    /*
      De urenregistratie. De socialrol boekt ook tijd — dat was nu net de reden
      dat de content op het bord staat — maar alleen haar eigen uren, en ze
      leest die van niemand anders. Wat het team geboekt heeft, is een
      bedrijfscijfer.
    */
    /*
      Uren. Het team ziet alles — dat is wat een werklastoverzicht is. Wie
      alleen komt werken (de socialrol, de ploeg) ziet en schrijft alleen zijn
      eigen uren: hoeveel een collega gewerkt heeft, gaat over zijn loon.
    */
    function eigenUren() {
      return isMember() && !isTeam();
    }

    match /timeEntries/{id} {
      allow read: if isTeam() || (eigenUren() && resource.data.profileId == request.auth.uid);
      allow create: if (isTeam() || eigenUren())
        && (request.resource.data.profileId == request.auth.uid || isAdmin());
      allow update, delete: if (isTeam() || eigenUren())
        && (resource.data.profileId == request.auth.uid || isAdmin());
    }

    // The running timer is keyed by uid, which is what makes "one timer per
    // person" true by construction instead of by convention.
    match /runningTimers/{uid} {
      allow read: if isTeam() || (isMember() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    /*
      De sleutel van je agenda-abonnement.

      Eén document per persoon, met het id van het profiel als naam, zodat er
      per persoon maar één sleutel kan bestaan — en een nieuwe sleutel de oude
      dus onmiddellijk ongeldig maakt.

      Lezen mag alleen jijzelf: wie de sleutel van iemand anders kan lezen, kan
      diens agenda lezen. De functie die de feed uitserveert leest met
      beheerdersrechten en gaat hier niet langs.
    */
    match /agendaSleutels/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /*
      De offertes.

      Alleen het planningsteam: er staan bedragen, kortingen en
      klantgegevens in. De klant zelf leest haar offerte niet hier maar op de
      publieke pagina, en die wordt door een functie met beheerdersrechten
      uitgeserveerd — die gaat hier niet langs. Zo is er geen enkele weg waarop
      een browser zonder login in deze collectie kan kijken, ook niet met het
      juiste token.
    */
    /*
      Een offerte draagt het geld. De regels staan als lijst op het document,
      dus die kan een regel hier niet stuk voor stuk nakijken — wel dat het
      een lijst is, en dat de sleutel waarmee de klant ze opent niet stilletjes
      van eigenaar verandert.

      `token` blijft: wie hem wijzigt, breekt de link die al bij de klant in
      een mail staat. Vernieuwen kan wel bewust, via `vernieuwToken`, en dat
      schrijft ook `updatedAt` — vandaar dat die uitzondering hier staat.
    */
    function offerteVorm() {
      return tekstOfNiets('nummer')
        && tekstOfNiets('status')
        && tekstOfNiets('klantNaam')
        && tekstOfNiets('eventNaam')
        && tekstOfNiets('locatie')
        && tekstOfNiets('token')
        && aantalOfNiets('personen')
        && bedragOfNiets('bedragExcl')
        && bedragOfNiets('bedragIncl')
        && lijstOfNiets('regels')
        && lijstOfNiets('onderdelen');
    }

    match /offertes/{id} {
      allow read:   if isTeam();
      allow create: if isTeam() && offerteVorm();
      allow update: if isTeam() && offerteVorm() && herkomstBlijft();
      allow delete: if isTeam();
    }

    /*
      Het logboek: wie heeft wat veranderd.

      Lezen doet het planningsteam — niet alleen de beheerders. Een logboek dat
      alleen de baas mag inkijken, is een controlemiddel; een logboek dat
      iedereen mag inkijken, is een geheugen. Dit is het tweede: de vraag die
      ermee beantwoord wordt is "wie heeft dit verzet en waarom", en die stelt
      het hele team aan elkaar.

      Personeel en de socialrol niet: er staan bedragen, rollen en klantnamen
      in.

      Schrijven kan niemand. De regels worden door triggers gezet, met
      beheerdersrechten, die hier sowieso niet langs gaan. Een logboek dat een
      browser kan aanvullen of bijwerken, bewijst niets — dan is elke regel erin
      "wat iemand wilde dat er stond".
    */
    match /auditLog/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    /*
      De post van info@jeconcept.be.

      Lezen doet het planningsteam: er staan klantgegevens, prijsafspraken en
      soms hele onderhandelingen in. Personeel en de socialrol niet — die
      hebben met de klant geen mailverkeer.

      Schrijven kan alleen de koppeling, en alleen door iemand van het team: de
      ophaler zet de berichten neer met beheerdersrechten en gaat hier niet
      langs, maar een mail met de hand aan het juiste event hangen moet wél
      vanuit het scherm kunnen. Daarom staat er hier een update op die drie
      velden en niets anders: de inhoud van een bericht hoort onaanraakbaar te
      zijn, anders is de draad geen bewijs meer van wat er gezegd is.
    */
    match /mails/{id} {
      allow read:   if isTeam();
      allow create: if false;
      allow delete: if false;
      allow update: if isTeam()
        && changedKeys().hasOnly(['eventId', 'customerId', 'koppeling', 'gelezen']);
    }

    /*
      Wat de tool over zichzelf bijhoudt: waar de ophaler gebleven was, en
      wanneer ze voor het laatst draaide. Het team leest het — dat is precies
      het punt, want tot nu las niemand het en viel de post in stilte stil.
      Schrijven doet alleen de ophaler, met beheerdersrechten.
    */
    match /instellingen/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    /*
      De wachtrij van de uitgaande post.

      Lezen mag het team: een mail die niet vertrok, hoort zichtbaar te zijn en
      niet alleen in een logbestand te staan. Schrijven doet de verzender, met
      beheerdersrechten; een browser die hier een rij kan bijzetten, kan post
      versturen uit naam van de zaak.
    */
    match /mailQueue/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    // Anything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
