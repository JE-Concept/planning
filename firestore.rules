rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ JE Planning — Firestore security rules                                   ║
// ║                                                                          ║
// ║ One shared workspace: every active profile reads and writes the planning.║
// ║ Not shared: member administration (admins only), your own time entries   ║
// ║ (you edit yours, admins edit all).                                       ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    // A profile only exists once `ensureProfile` accepted the e-mail address,
    // so "has a profile" is the membership check.
    function isMember() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true;
    }

    function role() {
      return get(profilePath()).data.role;
    }

    // De planningsgebruikers: iedereen met een profiel behalve personeel en de
    // socialrol.
    //
    // Personeel heeft een beperkte login — de openings- en sluitingslijst, en
    // verder niets. De socialrol werkt alleen in de socials. Dat onderscheid
    // staat hier en niet alleen in de interface, want een verborgen knop is
    // geen beveiliging.
    function isTeam() {
      return isMember() && role() != 'staff' && role() != 'social';
    }

    /*
      De socialrol: een medewerker die de content doet en verder niets.

      Wat ze niet mag lezen, is even belangrijk als wat ze wel mag: `tasks`
      staat niet in haar lijst, en daar staan de offertebedragen, budgetten en
      kostprijzen van elk event op. Firestore kan geen velden verbergen — wie
      een document mag lezen, leest het hele document, ook wat het scherm niet
      toont. Daarom leest ze de events uit `socialEvents`, een kale kopie
      zonder één bedrag erin, die een trigger bijhoudt.

      Datzelfde geldt voor `formules` (prijzen per persoon), `customers`
      (facturatiegegevens) en `offertes`. Die staan hier niet, en dat is het
      antwoord op "ze ziet geen prijzen".
    */
    function isSocial() {
      return isMember() && role() == 'social';
    }

    function isAdmin() {
      return isMember() && role() in ['owner', 'admin'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── People ────────────────────────────────────────────────────────────

    match /profiles/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);

      // Je mag je eigen kaartje bijwerken, maar nooit je eigen rol of toegang —
      // en dat geldt ook voor een beheerder. Wie zichzelf op "personeel" zet of
      // zichzelf archiveert, sluit zichzelf buiten en heeft dan niemand meer om
      // het terug te draaien. Dit hoort in de regels en niet alleen in een
      // uitgeschakeld keuzelijstje: een verborgen knop is geen beveiliging.
      allow update: if (isAdmin()
            && (request.auth.uid != uid || !changedKeys().hasAny(['role', 'active'])))
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['fullName', 'avatarUrl', 'prefs', 'updatedAt']));

      allow create, delete: if isAdmin();
    }

    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // Meldingen: één rij per toestel, gesleuteld op het token zelf.
    //
    // Je beheert alleen je eigen toestellen. Lezen mag ook alleen je eigen rij:
    // de lijst met tokens van de ploeg is niets voor in de browser — versturen
    // doet een Cloud Function, die er met beheerdersrechten bij kan.
    match /pushTokens/{token} {
      allow read, delete: if isMember() && resource.data.profileId == request.auth.uid;
      // Bij het schrijven telt de nieuwe eigenaar, niet de oude: meldt een
      // collega zich aan op een toestel waar jij aan stond, dan neemt zij die
      // rij over. Het token is het geheim van dat toestel — wie het heeft, ís
      // dat toestel.
      allow create, update: if isMember() && request.resource.data.profileId == request.auth.uid;
    }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // De postbak van de meldingen: één rij per e-mail die nog moet vertrekken.
    //
    // Dicht voor iedereen, ook voor beheerders. Er staan adressen en volledige
    // berichtteksten in van het hele team, en geen enkel scherm heeft ze nodig:
    // de triggers schrijven erin en de verzender leest eruit, allebei met
    // beheerdersrechten, die deze regels sowieso overslaan. Wat hier staat is
    // dus geen slot maar een bordje: dit is niets voor in een browser.
    match /mailQueue/{id} {
      allow read, write: if false;
    }

    // ── The workspace itself ──────────────────────────────────────────────

    // De merken en de lijsten leest de socialrol mee: zonder merk is een post
    // van niemand, en zonder lijst weet het bord niet welke kolommen het heeft.
    // Er staat geen bedrag in.
    match /brands/{id}      { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    match /spaces/{id}      { allow read: if isTeam(); allow write: if isTeam(); }
    match /folders/{id}     { allow read: if isTeam(); allow write: if isTeam(); }
    match /lists/{id}       { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    match /tags/{id}        { allow read: if isTeam() || isSocial(); allow write: if isTeam(); }
    /*
      De events en de taken. `tasks` draagt de bedragen, dus de socialrol leest
      er niets uit — ze werkt met de kale kopie in `socialEvents`.

      Schrijven mag ze wel, maar alleen wat over content gaat: de stand op het
      socialbord verzetten. Welke velden dat zijn staat hieronder als lijst, en
      niet als "alles behalve": vergeet je bij een verbodslijst één veld, dan
      kan ze het offertebedrag aanpassen zonder het ooit gezien te hebben.

      Een eigen socialtaak aanmaken en bijwerken mag volledig — die hangt aan
      een sociallijst en heeft met geld niets te maken.
    */
    function socialVelden() {
      return changedKeys().hasOnly(['socialStage', 'socialWanted', 'updatedAt', 'updatedBy', 'position']);
    }

    // Een sociallijst herken je aan de lijst zelf (`kind: 'social'`), niet aan
    // een veld op de taak: dat veld zou de schrijver zelf kunnen invullen.
    function lijstIsSocial(listId) {
      return exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.kind == 'social';
    }

    match /tasks/{id} {
      allow read:   if isTeam();
      allow write:  if isTeam();
      allow create: if isSocial() && lijstIsSocial(request.resource.data.listId);
      allow update: if isSocial()
        && (socialVelden() || (lijstIsSocial(resource.data.listId) && lijstIsSocial(request.resource.data.listId)));
      allow delete: if isSocial() && lijstIsSocial(resource.data.listId);
    }

    /*
      De kale kopie van de events, voor de socialrol.

      Alleen de trigger schrijft erin, met beheerdersrechten — die gaan hier
      sowieso niet langs. Dat niemand anders mag schrijven staat er toch, want
      een kopie die een browser kan bewerken is geen kopie meer.
    */
    match /socialEvents/{id} {
      allow read:  if isTeam() || isSocial();
      allow write: if false;
    }

    // Klanten: bedrijfsgegevens, contactpersonen en wat er aan documenten bij
    // hoort. Hetzelfde recht als de events die eraan hangen — wie de planning
    // doet, doet de klant.
    match /customers/{id}   { allow read: if isTeam(); allow write: if isTeam(); }
    match /comments/{id}    { allow read: if isTeam(); allow write: if isTeam(); }
    match /attachments/{id} { allow read: if isTeam(); allow write: if isTeam(); }
    match /goals/{id}       { allow read: if isTeam(); allow write: if isTeam(); }
    match /goalUpdates/{id} { allow read: if isTeam(); allow write: if isTeam(); }
    // De posts zelf: het werk van de socialrol.
    match /socialPosts/{id} { allow read: if isTeam() || isSocial(); allow write: if isTeam() || isSocial(); }

    // De lijsten zelf zijn beleid — die maakt een beheerder. De dagelijkse
    // runs zijn werk, en dat doet iedereen; niemand wist er een.
    // Een overleg staat als taak op het bord — die titel ziet het team. De
    // samenvatting zelf staat hier, en alleen wie erin genoemd is leest ze. De
    // query in de app filtert op datzelfde veld, zodat ze ook echt slaagt.
    // De agenda is van het hele team: iedereen zet er punten op. Dat is het
    // punt ervan — anders staat er alleen op wat de voorzitter onthield.
    match /agendaItems/{id} {
      allow read:          if isTeam();
      allow create, update: if isTeam();
      allow delete:        if isTeam()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /meetings/{id} {
      allow read:   if isMember() && request.auth.uid in resource.data.viewerIds;
      allow write:  if isAdmin();
    }

    // Business rules: het team ziet waarom een taak ineens van eigenaar wisselt,
    // beheerders bepalen de regels. Uitvoeren doet een Cloud Function met
    // beheerdersrechten, dus wat hier staat gaat alleen over het beheer.
    //
    // De entiteit wordt hier afgegrensd en niet alleen in het scherm. Een regel
    // draait met meer rechten dan wie hem schreef, dus "op welke collectie mag
    // een regel staan" is een beveiligingsvraag, geen keuzelijstje. Wat een
    // regel binnen die collectie mag aanraken, staat in `functions/rule-schema.js`:
    // de motor voert alleen uit wat daar als actie beschreven is, en een rol of
    // een toegang van een profiel staat daar bewust niet bij.
    function bekendeEntiteit() {
      return !('entity' in request.resource.data)
        || request.resource.data.entity in
             ['task', 'customer', 'socialPost', 'checklistRun', 'timeEntry', 'profile'];
    }

    match /automations/{id} {
      allow read:   if isTeam();
      allow create, update: if isAdmin() && bekendeEntiteit();
      allow delete: if isAdmin();
    }

    // Het logboek van de regels: welke regel vuurde, op welk document, en bij
    // een beslissingstabel op welke rij. Alleen de server schrijft erin — zij is
    // de enige die het weet — en niemand bewerkt achteraf wat er staat. Zelfde
    // afspraak als bij het activiteitenlog: rechtzetten doe je door een regel
    // bij te schrijven, niet door er een te herschrijven.
    match /automationRuns/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    // Eventtemplates: het team leest ze bij een nieuw event, een beheerder
    // bepaalt wat erin staat.
    match /templates/{id} {
      allow read:  if isTeam();
      allow write: if isAdmin();
    }

    // Vaste formules (winter bbq aan 29,90 met hapjes, drank en dessert): het
    // team kiest er een bij een nieuw event, een beheerder bepaalt de prijs en
    // de bestelregels. Een prijslijst is geen veld dat je onderweg bijstelt.
    match /formules/{id} {
      allow read:  if isTeam();
      allow write: if isAdmin();
    }

    match /checklists/{id} {
      allow read:  if isMember();
      allow write: if isAdmin();
    }

    match /checklistRuns/{id} {
      allow read:   if isMember();
      allow create, update: if isMember();
      allow delete: if isAdmin();
    }

    // The review log is written by the reviewer and read by
    // everyone; nobody edits a decision after the fact, they add the next one.
    match /postReviews/{id} {
      allow read:   if isTeam() || isSocial();
      allow create: if isTeam() || isSocial();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Het activiteitslog: wie wijzigde de status, de deadline, de uitvoerders.
    //
    // Iedereen schrijft erin — de app doet dat zelf bij elke wijziging — en
    // niemand bewerkt achteraf wat er staat. Dat is het hele nut ervan: een log
    // dat je kunt bijstellen beantwoordt de vraag "wie heeft dit verzet?" niet
    // meer. Rechtzetten gebeurt door een regel bij te schrijven, niet door er
    // een te herschrijven. De query in het takenpaneel vraagt op `taskId`, wat
    // deze regel toelaat en waar `firestore.indexes.json` een index voor heeft.
    match /activity/{id} {
      allow read:   if isTeam();
      allow create: if isTeam();
      allow update, delete: if isAdmin();
    }

    // ── Time tracking: everyone sees the numbers, you own your own rows ────

    // Het weekrooster.
    //
    // Iedereen met een profiel leest het, personeel inbegrepen: wie moet weten
    // wanneer hij werkt, moet het kunnen openen. Schrijven doet een beheerder —
    // een rooster waar ieder zijn eigen diensten in verzet, is geen rooster meer.
    match /shifts/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    /*
      De urenregistratie. De socialrol boekt ook tijd — dat was nu net de reden
      dat de content op het bord staat — maar alleen haar eigen uren, en ze
      leest die van niemand anders. Wat het team geboekt heeft, is een
      bedrijfscijfer.
    */
    match /timeEntries/{id} {
      allow read: if isTeam() || (isSocial() && resource.data.profileId == request.auth.uid);
      allow create: if (isTeam() || isSocial())
        && (request.resource.data.profileId == request.auth.uid || isAdmin());
      allow update, delete: if (isTeam() || isSocial())
        && (resource.data.profileId == request.auth.uid || isAdmin());
    }

    // The running timer is keyed by uid, which is what makes "one timer per
    // person" true by construction instead of by convention.
    match /runningTimers/{uid} {
      allow read: if isTeam() || (isSocial() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    /*
      De sleutel van je agenda-abonnement.

      Eén document per persoon, met het id van het profiel als naam, zodat er
      per persoon maar één sleutel kan bestaan — en een nieuwe sleutel de oude
      dus onmiddellijk ongeldig maakt.

      Lezen mag alleen jijzelf: wie de sleutel van iemand anders kan lezen, kan
      diens agenda lezen. De functie die de feed uitserveert leest met
      beheerdersrechten en gaat hier niet langs.
    */
    match /agendaSleutels/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /*
      De offertes.

      Alleen het planningsteam: er staan bedragen, kortingen en
      klantgegevens in. De klant zelf leest haar offerte niet hier maar op de
      publieke pagina, en die wordt door een functie met beheerdersrechten
      uitgeserveerd — die gaat hier niet langs. Zo is er geen enkele weg waarop
      een browser zonder login in deze collectie kan kijken, ook niet met het
      juiste token.
    */
    match /offertes/{id} {
      allow read, write: if isTeam();
    }

    /*
      Het logboek: wie heeft wat veranderd.

      Lezen doet het planningsteam — niet alleen de beheerders. Een logboek dat
      alleen de baas mag inkijken, is een controlemiddel; een logboek dat
      iedereen mag inkijken, is een geheugen. Dit is het tweede: de vraag die
      ermee beantwoord wordt is "wie heeft dit verzet en waarom", en die stelt
      het hele team aan elkaar.

      Personeel en de socialrol niet: er staan bedragen, rollen en klantnamen
      in.

      Schrijven kan niemand. De regels worden door triggers gezet, met
      beheerdersrechten, die hier sowieso niet langs gaan. Een logboek dat een
      browser kan aanvullen of bijwerken, bewijst niets — dan is elke regel erin
      "wat iemand wilde dat er stond".
    */
    match /auditLog/{id} {
      allow read:  if isTeam();
      allow write: if false;
    }

    // Anything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
