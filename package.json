{
  "name": "je-planning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JE Plan — interne planningstool voor JE Concept (Kanban, social media kalender, timetracking, goals)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "controleer": "npm run lint && npm test && npm run build && npm run smoke && npm run smoke:verhuur && npm run mobiel && npm run taalcheck",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "dev": "vite",
    "emulators": "firebase emulators:start",
    "lint": "eslint .",
    "migrate:clickup": "node scripts/migrate-clickup.mjs",
    "preview": "vite preview",
    "mobiel": "node scripts/mobiel.mjs",
    "smoke": "npm run build:demo && node scripts/smoke.mjs",
    "taalcheck": "node scripts/taalcheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "offerte:voorbeeld": "npm run build:demo && node scripts/offerte-voorbeeld.mjs",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project je-planning-rules-test \"vitest run tests/rules tests/messaging-ingang tests/stripe-webhook tests/verhuur-event\"",
    "build:verhuur": "vite build --config vite.verhuur.config.js",
    "dev:verhuur": "vite --config vite.verhuur.config.js",
    "smoke:verhuur": "npm run build:verhuur && node scripts/verhuur-smoke.mjs",
    "build:verhuur:demo": "vite build --config vite.verhuur.config.js --mode demo && node scripts/verhuur-preview.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "globals": "^15.11.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
